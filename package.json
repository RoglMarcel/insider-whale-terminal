{
  "name": "insider-whale-terminal",
  "version": "1.6.1",
  "description": "Insider & Whale Stock Signal Tracker — desktop app that scrapes insider trading and unusual options flow, scores conviction, and ranks tickers.",
  "author": "Insider Tracker",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "analysis:catalogue": "esbuild scripts/build-analysis-catalogue.ts --bundle --platform=node --format=cjs --outfile=tmp/build-analysis-catalogue.cjs && node tmp/build-analysis-catalogue.cjs",
    "analysis:serve": "esbuild scripts/analysis-server.ts --bundle --platform=node --format=cjs --outfile=tmp/analysis-server.cjs && node tmp/analysis-server.cjs",
    "dev": "vite",
    "dev:web": "vite --config vite.config.web.ts",
    "build": "vite build",
    "build:web": "vite build --config vite.config.web.ts",
    "scrape:web": "esbuild scripts/scrape-web.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --external:playwright --alias:electron=./scripts/electron-stub.ts --outfile=tmp/scrape-web.cjs && node tmp/scrape-web.cjs",
    "label:outcomes": "esbuild scripts/label-outcomes.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --alias:electron=./scripts/electron-stub.ts --outfile=tmp/label-outcomes.cjs && node scripts/run-node-or-electron.cjs tmp/label-outcomes.cjs",
    "publish:data": "esbuild scripts/publish-data.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --alias:electron=./scripts/electron-stub.ts --outfile=tmp/publish-data.cjs && node tmp/publish-data.cjs",
    "publish:web": "esbuild scripts/publish-web.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --external:playwright --external:electron --outfile=tmp/publish-web.cjs && electron tmp/publish-web.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "rebuild": "electron-builder install-app-deps",
    "verify:scoring": "esbuild scripts/verify-scoring.ts --bundle --platform=node --format=cjs --outfile=tmp/verify-scoring.cjs && node tmp/verify-scoring.cjs",
    "verify:db": "esbuild scripts/verify-db.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --outfile=tmp/verify-db.cjs && electron tmp/verify-db.cjs",
    "verify:scrape": "esbuild scripts/verify-scrape.ts --bundle --platform=node --format=cjs --external:playwright --external:better-sqlite3 --outfile=tmp/verify-scrape.cjs && node tmp/verify-scrape.cjs",
    "backtest": "esbuild scripts/backtest.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --external:electron --outfile=tmp/backtest.cjs && electron tmp/backtest.cjs",
    "backtest:components": "esbuild scripts/backtest-components.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --outfile=tmp/backtest-components.cjs && electron tmp/backtest-components.cjs",
    "backtest:opportunistic": "esbuild scripts/backtest-opportunistic.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --outfile=tmp/backtest-opportunistic.cjs && electron tmp/backtest-opportunistic.cjs",
    "postinstall": "electron-builder install-app-deps",
    "analyze:score": "esbuild scripts/analyze-score.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --alias:electron=./scripts/electron-stub.ts --outfile=tmp/analyze-score.cjs && node scripts/run-node-or-electron.cjs tmp/analyze-score.cjs",
    "backfill:tickers": "esbuild scripts/backfill-tickers.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --external:playwright --alias:electron=./scripts/electron-stub.ts --outfile=tmp/backfill-tickers.cjs && node scripts/run-node-or-electron.cjs tmp/backfill-tickers.cjs",
    "rescore:history": "esbuild scripts/rescore-history.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --alias:electron=./scripts/electron-stub.ts --outfile=tmp/rescore-history.cjs && node scripts/run-node-or-electron.cjs tmp/rescore-history.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden:update": "esbuild scripts/gen-golden.ts --bundle --platform=node --format=cjs --outfile=tmp/gen-golden.cjs && node tmp/gen-golden.cjs",
    "portfolio:sync": "esbuild scripts/sync-portfolio.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --alias:electron=./scripts/electron-stub.ts --outfile=tmp/sync-portfolio.cjs && node scripts/run-node-or-electron.cjs tmp/sync-portfolio.cjs",
    "portfolio:sweep": "esbuild scripts/portfolio-sweep.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --alias:electron=./scripts/electron-stub.ts --outfile=tmp/portfolio-sweep.cjs && node scripts/run-node-or-electron.cjs tmp/portfolio-sweep.cjs",
    "verify:portfolio": "esbuild scripts/verify-portfolio.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --alias:electron=./scripts/electron-stub.ts --outfile=tmp/verify-portfolio.cjs && node scripts/run-node-or-electron.cjs tmp/verify-portfolio.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.9.3",
    "node-cron": "^3.0.3",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.9",
    "zustand": "^4.5.4"
  }
}
